{
  "name": "hackathon2026-bolzano-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "data": "uv run --no-project --python 3.11 --with openpyxl --with shapely --with pillow --with numpy --with pandas sh -c \"python scripts/build_world.py && python scripts/build_details.py\"",
    "model": "uv run --no-project python scripts/sync_model.py",
    "test:model": "node scripts/test_model.ts",
    "pipeline": "npm run model && npm run data && npm run test:model"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@tailwindcss/vite": "^4.3.5",
    "camera-controls": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.72.0",
    "postprocessing": "^6.39.6",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.170.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "pyodide": "^314.0.7",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
